# 探店地图 - 配置文件模板
# 复制此文件为 .env 并填入真实值，修改后重启服务生效

# LLM API（AI视频分析）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-v4-pro

# 高德地图 API（地理编码，可选）
AMAP_API_KEY=your_amap_api_key_here

# 语音转文字（可选，未配置则使用本地 Whisper 模型）
STT_USE_REMOTE_API=true
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
# 百炼 Qwen3-ASR-Flash 示例：
# STT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# STT_MODEL=qwen3-asr-flash
STT_LOCAL_MODEL=small

# 地图默认中心点（成都）
MAP_CENTER_LAT=30.655
MAP_CENTER_LNG=104.075
MAP_DEFAULT_ZOOM=13
