.mine-page {
  min-height: 100vh;
  padding: calc(28rpx + env(safe-area-inset-top)) 28rpx 48rpx;
  background: #0d1016;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: #121620;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  background: #ff6b35;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.nickname {
  color: #f5f5f7;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-subtitle {
  margin-top: 8rpx;
  color: #8f96a8;
  font-size: 24rpx;
  line-height: 1.4;
}

.login-btn {
  flex-shrink: 0;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: #ff6b35;
}

.login-btn.secondary {
  color: #c8ceda;
  background: rgba(255, 255, 255, 0.08);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.stat-item {
  padding: 22rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.05);
}

.stat-value {
  display: block;
  color: #f5f5f7;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: #8f96a8;
  font-size: 22rpx;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  margin: 0 4rpx 14rpx;
  color: #f5f5f7;
  font-size: 28rpx;
  font-weight: 800;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: #121620;
}

.menu-item {
  width: 100%;
  height: 92rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #e7ebf3;
  font-size: 28rpx;
  text-align: left;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-arrow {
  color: #677087;
  font-size: 40rpx;
}

.favorite-card {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  color: #e7ebf3;
  background: #121620;
  text-align: left;
}

.favorite-name {
  color: #f5f5f7;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.favorite-meta {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
  color: #ff9a56;
  font-size: 23rpx;
}

.favorite-address {
  margin-top: 10rpx;
  color: #8f96a8;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-line {
  padding: 32rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  color: #8f96a8;
  background: #121620;
  font-size: 26rpx;
  text-align: center;
}

.drawer-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.46);
}

.favorite-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 51;
  width: 86vw;
  max-width: 680rpx;
  padding-top: env(safe-area-inset-top);
  background: #0f131c;
  box-shadow: -24rpx 0 70rpx rgba(0, 0, 0, 0.42);
  transform: translateX(100%);
  transition: transform 240ms ease;
}

.favorite-drawer.open {
  transform: translateX(0);
}

.drawer-header {
  min-height: 126rpx;
  padding: 28rpx 28rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.drawer-title {
  color: #f5f5f7;
  font-size: 34rpx;
  font-weight: 800;
}

.drawer-subtitle {
  margin-top: 6rpx;
  color: #8f96a8;
  font-size: 23rpx;
}

.drawer-close {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #f5f5f7;
  background: rgba(255, 255, 255, 0.08);
  font-size: 42rpx;
  line-height: 1;
}

.drawer-body {
  height: calc(100vh - 126rpx - env(safe-area-inset-top));
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
